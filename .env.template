# ============================================================================
# openproxy 配置模板
#
# 用法：
#   cp .env.template .env && 填上你要改的值
#
# `.env` **不要提交**（已在 .gitignore 里），本模板**要提交**。
#
# 优先级：**真实环境变量 > .env 文件 > 内置默认值**
#   `docker run -e OPENPROXY_PORT=9000` 这类显式传参压过文件里的值——
#   「这一次的意图」应该压过「文件里的基线」。
#
# 格式：只有 `#` 注释、空行、`KEY=VALUE`、可选的成对引号。
#   **不支持** `export` 前缀（虽然会被忽略掉）、多行值、变量插值 `$VAR`。
#   写错的行会被**跳过而不是报错** —— 一个笔误不该让服务起不来。
# ============================================================================

# ---------------------------------------------------------------- 本站监听 ---

# openproxy 自己监听的地址与端口。
OPENPROXY_HOST=127.0.0.1
OPENPROXY_PORT=8787

# SQLite 文件路径。相对路径以**当前工作目录**为基准。
OPENPROXY_DB_PATH=data/openproxy.db

# ---------------------------------------------------------------- 上游直连 ---

# 直连 opencode.ai 的地址。**只有走「直通」路径的模型才用它**
# （免费模型里目前只有 space-bunny-free 能直连，其余会被上游 403）。
OPENPROXY_UPSTREAM_BASE=https://opencode.ai/zen

# 上游 API key。不填则匿名访问 —— 而匿名只能调 space-bunny-free。
# 填了之后所有 free 模型都能直连，也就不需要 opencode 转发了。
#OPENPROXY_UPSTREAM_KEY=

# 转发给上游的 User-Agent（部分上游会按 UA 区分客户端）。
#OPENPROXY_UPSTREAM_USER_AGENT=openproxy/1.0 (+https://github.com/local/openproxy)

# 超时。connect 管「连上要多久」，read 管「连上后等多久」。
# 注意 read_timeout 同时是**直连路径**的上限，所以别设得比你的模型慢。
OPENPROXY_CONNECT_TIMEOUT=15
OPENPROXY_READ_TIMEOUT=600

# ------------------------------------------------------------ opencode 转发 ---

# 本机 opencode 服务的地址。
#
# **端口要与实际跑的 opencode 一致**，否则转发会 504
# 「本机连不上...」。查端口：
#   lsof -nP -iTCP -sTCP:LISTEN | grep opencode
#
# 用 `opencode serve --port <端口> --hostname 127.0.0.1` 自己起一个时，
# 把它填成同一个端口。**桌面版（OpenCode.app）的端口每次启动都变**，
# 所以不要指向桌面版 —— 起一个固定端口的服务更可靠。
OPENPROXY_OPENCODE_BASE=http://127.0.0.1:10490

# opencode 服务的密码。留空则自动从 ~/.config/opencode/service.json 读
# （桌面版与 `serve` 都会写这个文件）。手填优先于自动读取。
#OPENPROXY_OPENCODE_PASSWORD=

# 转发给 opencode 的工作目录（它决定 opencode 用哪个项目的配置与上下文）。
# 不填则用当前工作目录。
#
# 它**不能**用来隔离全局 AGENTS.md —— 实测 2026-10-06：指向一个空目录后，
# opencode照样会读 ~/.config/opencode/AGENTS.md（那些指令是全局加载的）。
# 它只影响 opencode「这个会话属于哪个项目」。
#OPENPROXY_OPENCODE_DIRECTORY=

# 经 opencode 转发的总时长上限（秒）。计时从「投递 prompt」开始，
# 不是单次 HTTP 超时—— 中间会轮询很多次。
OPENPROXY_OPENCODE_TIMEOUT=120

# ------------------------------------------------------------------ 行为 ---

# 只允许转发清单内的免费模型。关掉就能转发任意模型名。
OPENPROXY_FREE_MODELS_ONLY=true

# 流式响应结束时若上游没给 usage，注入一个合成的 usage 帧
# （让客户端能显示用量）。关掉则原样透传。
OPENPROXY_INJECT_STREAM_USAGE=true

# 强制思考级别：``minimal`` / ``low`` / ``medium`` / ``high`` / ``max``。
# 留空 = 不注入（以上游默认为准）。注意这只对**直连**路径生效；
# 经 opencode 转发时该字段会被它忽略（它只吃一个字符串 prompt）。
#OPENPROXY_REASONING_EFFORT=

# 用量保留天数。0 = 清空历史（**不可恢复**，慎用）。
OPENPROXY_RETAIN_DAYS=90

# 每日 token 配额（按 key 计）。0 = 不限。
#OPENPROXY_DAILY_TOKEN_QUOTA=0

# 「站外可达性」每日探测的开关。它会**真的发 10 次请求**去 opencode.ai，
# 所以默认开着（用于在控制台标出哪些模型站外真的可调）。
OPENPROXY_PROBE_REACHABILITY=true

# ------------------------------------------------------------------ 安全 ---

# 强制下游必须带本站签发的密钥。**暴露到局域网之前必须打开**，
# 否则任何人都能用你的额度。
OPENPROXY_REQUIRE_KEY=false

# 控制台管理令牌。留空则不校验 —— 只在绑 127.0.0.1 时可接受。
# 绑 0.0.0.0 又留空 = 管理接口裸奔。
#OPENPROXY_ADMIN_TOKEN=